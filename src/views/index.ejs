<%- include('includes/header') %>

<!-- ===== Auth hero with Login / Sign up ===== -->
<section class="auth-hero">
  <div class="auth-stage">

    <!-- Intro + hover buttons (shown first) -->
    <div class="auth-intro">
      <p class="eyebrow mb-1">Administrator Console</p>
      <h1>German Engineering,<br>Managed With Precision</h1>
      <p>Hover a button to begin — sign in or create your admin account.</p>
    </div>

    <div class="auth-launcher">
      <button type="button" class="launch-btn gold" data-auth-open="login">Log in</button>
      <button type="button" class="launch-btn ghost" data-auth-open="signup">Sign up</button>
    </div>

    <div class="auth-card" id="authCard">
      <div class="text-center mb-3">
        <p class="eyebrow mb-1">Admin Access</p>
        <h1 class="mb-1" style="font-size:30px;">Welcome Back</h1>
        <p class="text-muted-2 mb-0" style="font-size:14px;">Manage the Autobahn Korea fleet and members.</p>
      </div>

      <!-- Toggle -->
      <div class="auth-tabs">
        <button type="button" class="auth-tab <%= authView === 'login' ? 'active' : '' %>" id="tabLoginBtn" data-auth-tab="login">Log in</button>
        <button type="button" class="auth-tab <%= authView === 'signup' ? 'active' : '' %>" id="tabSignupBtn" data-auth-tab="signup">Sign up</button>
      </div>

      <!-- LOGIN -->
      <form id="loginForm" action="/admin/login" method="POST" class="<%= authView === 'login' ? '' : 'auth-hidden' %>">
        <div class="mb-3">
          <label class="form-label" for="loginNick">Nickname</label>
          <input type="text" id="loginNick" name="memberNick" class="form-control member-nick" placeholder="admin" autocomplete="username" required />
        </div>
        <div class="mb-2">
          <label class="form-label" for="loginPassword">Password</label>
          <input type="password" id="loginPassword" name="memberPassword" class="form-control member-password" placeholder="••••••••" autocomplete="current-password" required />
        </div>
        <div class="d-flex justify-content-between align-items-center mb-3">
          <label class="d-flex align-items-center gap-2 text-muted-2" style="font-size:13px;">
            <input type="checkbox" class="form-check-input mt-0" /> Remember me
          </label>
          <a href="#" style="font-size:13px;">Forgot password?</a>
        </div>
        <button type="submit" class="btn btn-gold w-100">Log in to dashboard</button>
      </form>

      <!-- SIGN UP -->
      <form
        id="signupForm"
        action="/admin/signup"
        method="POST"
        class="<%= authView === 'signup' ? '' : 'auth-hidden' %>"
        enctype="multipart/form-data">

        <!-- Profile image upload with live preview -->
        <div class="upload-block mb-3">
          <div class="upload-preview">
            <i class="bi bi-person upload-placeholder"></i>
            <img class="upload-img-frame" alt="Profile preview" />
          </div>
          <div class="upload-actions d-flex justify-content-center gap-2">
            <label class="btn btn-outline-ink btn-sm mb-0">
              <i class="bi bi-upload me-1"></i><span class="upload-btn-text">Upload photo</span>
              <input type="file" name="memberImage" class="upload-input d-none member-image" accept="image/png, image/jpeg, image/jpg" required />
            </label>
          </div>
          <input type="text" class="upload-name" readonly />
          <p class="text-muted-2 mt-2 mb-0" style="font-size:12px;">JPG, JPEG or PNG. Preview shows before you sign up.</p>
        </div>

        <div class="mb-3">
          <label class="form-label" for="signupNick">Nick name</label>
          <input type="text" id="signupNick" name="memberNick" class="form-control member-nick" placeholder="Jason" required />
        </div>
        <div class="mb-3">
          <label class="form-label" for="signupPhone">Phone</label>
          <input type="text" id="signupPhone" name="memberPhone" class="form-control member-phone" placeholder="+82 10 1234 5678" required />
        </div>
        <div class="mb-3">
          <label class="form-label" for="signupPassword">Password</label>
          <input type="password" id="signupPassword" name="memberPassword" class="form-control member-password" placeholder="Create a password" autocomplete="new-password" required />
        </div>
        <button type="submit" class="btn btn-ink w-100">Create an account</button>
      </form>

      <p class="text-center text-muted-2 mt-3 mb-0" style="font-size:12px;">
        Protected area · Autobahn Korea Co., Ltd.
      </p>
    </div>
  </div>
</section>

<%- include('includes/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/config.js"></script>
<script src="/js/auth.js"></script>
