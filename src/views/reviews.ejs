<%- include('includes/header') %>

    <main class="container">
      <!-- Page head -->
      <div class="page-head d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
          <p class="eyebrow mb-1">Fleet Management</p>
          <h1 class="section-title">Vehicles</h1>
          <p class="text-muted-2 mb-0">Manage every car in the Autobahn showroom — pause, process or remove listings.
          </p>
        </div>
        <button class="btn btn-gold" data-bs-toggle="modal" data-bs-target="#addVehicleModal">
          <i class="bi bi-plus-lg me-1"></i>Add new vehicle
        </button>
      </div>

      <!-- Toolbar -->
      <div class="toolbar my-4">
        <span class="chip active" data-category="all">All</span>
        <span class="chip" data-category="Sedan">Sedan</span>
        <span class="chip" data-category="Coupe">Coupe</span>
        <span class="chip" data-category="SUV">SUV</span>
        <span class="chip" data-category="Hatchback">Hatchback</span>
        <span class="chip" data-category="Electric">Electric</span>

        <div class="ms-auto d-flex align-items-center gap-2 flex-wrap">
          <!-- Status filter -->
          <select id="statusFilter" class="form-select" style="width:auto;">
            <option value="all">All statuses</option>
            <option value="Active">Active</option>
            <option value="Paused">Paused</option>
            <option value="Deleted">Deleted</option>
          </select>
          <!-- Search -->
          <div class="position-relative" style="min-width:220px;">
            <i class="bi bi-search position-absolute text-muted-2" style="left:12px;top:11px;"></i>
            <input id="searchInput" class="form-control ps-4" placeholder="Search models…" />
          </div>
        </div>
      </div>

      <!-- Table -->
      <div class="ab-card ab-table-wrap">
        <div class="table-responsive">
          <table class="table ab-table align-middle">
            <thead>
              <tr>
                <th>Vehicle</th>
                <th>Member</th>
                <th>Content</th>
                <th>Status</th>
                <th class="text-end">Rating</th>
              </tr>
            </thead>
            <tbody>
              <!-- Row -->
              <tr class="veh-row" data-category="Coupe" data-status="Active" data-name="porsche 911 carrera">
                <td>
                  <div class="veh-cell">
                    <span class="veh-thumb"></span>
                    <span>
                      <span class="veh-brand d-block">Porsche</span>
                      <span class="veh-name">911 Carrera</span>
                    </span>
                  </div>
                </td>
                <td>Nodir</td>
                <td class="price-cell">This car is new</td>
                <td><span class="ab-badge badge-active">Active</span></td>
                <td class="text-end">
                  4 star
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <!-- ===== Add New Vehicle Modal ===== -->
    <div class="modal fade" id="addVehicleModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Add New Vehicle</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <form onsubmit="return false;">
            <div class="modal-body">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Brand</label>
                  <select class="form-select">
                    <option>BMW</option>
                    <option>Mercedes-Benz</option>
                    <option>Audi</option>
                    <option>Porsche</option>
                    <option>Volkswagen</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Model name</label>
                  <input class="form-control" placeholder="e.g. M4 Competition" />
                </div>
                <div class="col-md-4">
                  <label class="form-label">Category</label>
                  <select class="form-select">
                    <option>Sedan</option>
                    <option>Coupe</option>
                    <option>SUV</option>
                    <option>Hatchback</option>
                    <option>Electric</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Monthly price (₩)</label>
                  <input type="number" class="form-control" placeholder="2190000" />
                </div>
                <div class="col-md-4">
                  <label class="form-label">Status</label>
                  <select class="form-select">
                    <option>Active</option>
                    <option>Paused</option>
                    <option>Processing</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Power (hp)</label>
                  <input type="number" class="form-control" placeholder="510" />
                </div>
                <div class="col-md-4">
                  <label class="form-label">Fuel</label>
                  <select class="form-select">
                    <option>Petrol</option>
                    <option>Diesel</option>
                    <option>Hybrid</option>
                    <option>Electric</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Seats</label>
                  <input type="number" class="form-control" placeholder="4" />
                </div>
                <div class="col-12">
                  <label class="form-label">Description</label>
                  <textarea class="form-control" rows="3"
                    placeholder="Short description shown on the fleet page…"></textarea>
                </div>
                <div class="col-12">
                  <label class="form-label">Vehicle image</label>
                  <input type="file" class="form-control" accept="image/*" />
                </div>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-ink" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-gold"><i class="bi bi-check-lg me-1"></i>Save vehicle</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <%- include('includes/footer') %>

      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>