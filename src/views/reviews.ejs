<%- include('includes/header') %>

<main class="container">
  <!-- Page head -->
  <div class="page-head d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
      <p class="eyebrow mb-1">Community</p>
      <h1 class="section-title">Reviews</h1>
      <p class="text-muted-2 mb-0">Moderate member feedback — approve it to publish, or reject what breaks the rules.</p>
    </div>
  </div>

  <!-- Toolbar -->
  <div class="toolbar my-4">
    <span class="chip active" data-status="all">All</span>
    <span class="chip" data-status="PENDING">Pending</span>
    <span class="chip" data-status="APPROVED">Approved</span>
    <span class="chip" data-status="REJECTED">Rejected</span>

    <div class="ms-auto d-flex align-items-center gap-2 flex-wrap">
      <select id="ratingFilter" class="form-select" style="width: 140px;">
        <option value="all">All ratings</option>
        <option value="5">5 stars</option>
        <option value="4">4 stars</option>
        <option value="3">3 stars</option>
        <option value="2">2 stars</option>
        <option value="1">1 star</option>
      </select>
      <div class="ab-search">
        <i class="bi bi-search"></i>
        <input id="searchInput" class="form-control" placeholder="Search reviews…" />
      </div>
    </div>
  </div>

  <!-- Table -->
  <div class="ab-card ab-table-wrap">
    <div class="table-responsive">
      <table class="table ab-table align-middle">
        <thead>
          <tr>
            <th>Vehicle</th>
            <th>Member</th>
            <th>Content</th>
            <th>Rating</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody id="reviewTableBody"></tbody>
      </table>
    </div>
  </div>

  <!-- Pagination -->
  <div class="ab-pager d-flex justify-content-between align-items-center flex-wrap gap-2">
    <p class="ab-result-count text-muted-2 mb-0" id="resultCount"></p>
    <div class="d-flex align-items-center gap-2">
      <button class="btn btn-outline-ink btn-sm" id="prevPage" disabled>
        <i class="bi bi-chevron-left"></i> Prev
      </button>
      <span class="text-muted-2" id="pageLabel" style="font-size:13px;"></span>
      <button class="btn btn-outline-ink btn-sm" id="nextPage" disabled>
        Next <i class="bi bi-chevron-right"></i>
      </button>
    </div>
  </div>
</main>

<%- include('includes/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/config.js"></script>
<script src="/js/reviews.js"></script>
