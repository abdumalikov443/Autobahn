<%
  // `page` marks the active nav item. The auth screen passes "auth" and gets no nav links.
  const current = typeof page !== 'undefined' ? page : '';
  const navItems = [
    { key: 'vehicles', href: '/admin/vehicle/all', icon: 'bi-car-front',  label: 'Vehicles' },
    { key: 'orders',   href: '/admin/order/all',   icon: 'bi-receipt',    label: 'Orders'   },
    { key: 'reviews',  href: '/admin/review/all',  icon: 'bi-chat-quote', label: 'Reviews'  },
    { key: 'users',    href: '/admin/user/all',    icon: 'bi-people',     label: 'Users'    }
  ];
%>
<!DOCTYPE html>
<html lang="en" class="bg-body">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Autobahn Korea · Admin</title>
  <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <link href="/css/admin.css" rel="stylesheet" />
</head>

<body>
  <!-- ===== Navbar (partial) ===== -->
  <nav class="ab-navbar">
    <div class="container d-flex align-items-center justify-content-between">
      <a class="ab-brand" href="<%= current === 'auth' ? '/admin' : '/admin/vehicle/all' %>">
        <span class="logo-box">A</span>
        <span>
          <span class="brand-name d-block">AUTOBAHN</span>
          <span class="brand-sub">KOREA · ADMIN</span>
        </span>
      </a>
      <% if (current !== 'auth') { %>
      <div class="d-flex align-items-center gap-1">
        <% navItems.forEach(function (item) { %>
          <a class="ab-nav-link <%= current === item.key ? 'active' : '' %>" href="<%= item.href %>">
            <i class="bi <%= item.icon %> me-1"></i><%= item.label %>
          </a>
        <% }) %>
        <a class="btn btn-ghost-light btn-sm ms-2" href="/admin/logout">
          <i class="bi bi-box-arrow-right me-1"></i>Logout
        </a>
      </div>
      <% } %>
    </div>
  </nav>
