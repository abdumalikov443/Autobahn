<%- include('includes/header') %>

<body>

  <!-- ===== Navbar (partial) ===== -->
  <nav class="ab-navbar">
    <div class="container d-flex align-items-center justify-content-between">
      <a class="ab-brand" href="./vehicles.html">
        <span class="logo-box">A</span>
        <span>
          <span class="brand-name d-block">AUTOBAHN</span>
          <span class="brand-sub">KOREA · ADMIN</span>
        </span>
      </a>
      <div class="d-flex align-items-center gap-1">
        <a class="ab-nav-link" href="./vehicles.html"><i class="bi bi-car-front me-1"></i>Vehicles</a>
        <a class="ab-nav-link active" href="./users.html"><i class="bi bi-people me-1"></i>Users</a>
        <a class="btn btn-ghost-light btn-sm ms-2" href="./index.html">
          <i class="bi bi-box-arrow-right me-1"></i>Logout
        </a>
      </div>
    </div>
  </nav>

  <main class="container">
    <!-- Page head -->
    <div class="page-head d-flex flex-wrap justify-content-between align-items-end gap-3">
      <div>
        <p class="eyebrow mb-1">Member Management</p>
        <h1 class="section-title">Users</h1>
        <p class="text-muted-2 mb-0">Review members, activate accounts, block abuse or remove users.</p>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="toolbar my-4">
      <span class="chip active">All</span>
      <span class="chip">Active</span>
      <span class="chip">Blocked</span>
      <div class="ms-auto position-relative" style="min-width:260px;">
        <i class="bi bi-search position-absolute text-muted-2" style="left:12px;top:11px;"></i>
        <input class="form-control ps-4" placeholder="Search users…" />
      </div>
    </div>

    <!-- Table -->
    <div class="ab-card ab-table-wrap">
      <div class="table-responsive">
        <table class="table ab-table align-middle">
          <thead>
            <tr>
              <th>User</th>
              <th>Membership</th>
              <th>Active Leases</th>
              <th>Member Since</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>
                <div class="veh-cell">
                  <span class="ab-avatar">JP</span>
                  <span>
                    <span class="veh-name d-block">Ji-woo Park</span>
                    <span class="text-muted-2" style="font-size:13px;">jiwoo.park@example.com</span>
                  </span>
                </div>
              </td>
              <td>Autobahn Black</td>
              <td>2</td>
              <td>02 Nov 2024</td>
              <td><span class="ab-badge badge-active">Active</span></td>
              <td class="text-end">
                <a class="act-btn act-activate" title="Activate" href="#"><i class="bi bi-check-lg"></i></a>
                <a class="act-btn act-block" title="Block" href="#"><i class="bi bi-slash-circle"></i></a>
                <a class="act-btn act-delete" title="Delete" href="#"><i class="bi bi-trash"></i></a>
              </td>
            </tr>
            <tr>
              <td>
                <div class="veh-cell">
                  <span class="ab-avatar">MK</span>
                  <span>
                    <span class="veh-name d-block">Min-jun Kim</span>
                    <span class="text-muted-2" style="font-size:13px;">minjun.kim@example.com</span>
                  </span>
                </div>
              </td>
              <td>Autobahn Silver</td>
              <td>1</td>
              <td>14 Jan 2025</td>
              <td><span class="ab-badge badge-active">Active</span></td>
              <td class="text-end">
                <a class="act-btn act-activate" title="Activate" href="#"><i class="bi bi-check-lg"></i></a>
                <a class="act-btn act-block" title="Block" href="#"><i class="bi bi-slash-circle"></i></a>
                <a class="act-btn act-delete" title="Delete" href="#"><i class="bi bi-trash"></i></a>
              </td>
            </tr>
            <tr>
              <td>
                <div class="veh-cell">
                  <span class="ab-avatar">SL</span>
                  <span>
                    <span class="veh-name d-block">Seo-yeon Lee</span>
                    <span class="text-muted-2" style="font-size:13px;">seoyeon.lee@example.com</span>
                  </span>
                </div>
              </td>
              <td>Autobahn Silver</td>
              <td>0</td>
              <td>27 Mar 2025</td>
              <td><span class="ab-badge badge-blocked">Blocked</span></td>
              <td class="text-end">
                <a class="act-btn act-activate" title="Activate" href="#"><i class="bi bi-check-lg"></i></a>
                <a class="act-btn act-block" title="Block" href="#"><i class="bi bi-slash-circle"></i></a>
                <a class="act-btn act-delete" title="Delete" href="#"><i class="bi bi-trash"></i></a>
              </td>
            </tr>
            <tr>
              <td>
                <div class="veh-cell">
                  <span class="ab-avatar">DJ</span>
                  <span>
                    <span class="veh-name d-block">Do-yun Jang</span>
                    <span class="text-muted-2" style="font-size:13px;">doyun.jang@example.com</span>
                  </span>
                </div>
              </td>
              <td>Autobahn Black</td>
              <td>3</td>
              <td>09 May 2025</td>
              <td><span class="ab-badge badge-active">Active</span></td>
              <td class="text-end">
                <a class="act-btn act-activate" title="Activate" href="#"><i class="bi bi-check-lg"></i></a>
                <a class="act-btn act-block" title="Block" href="#"><i class="bi bi-slash-circle"></i></a>
                <a class="act-btn act-delete" title="Delete" href="#"><i class="bi bi-trash"></i></a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <%- include('includes/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
