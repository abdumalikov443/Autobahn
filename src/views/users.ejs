<%- include('includes/header') %>

<main class="container">
  <!-- Page head -->
  <div class="page-head d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
      <p class="eyebrow mb-1">Member Management</p>
      <h1 class="section-title">Users</h1>
      <p class="text-muted-2 mb-0">Review members, activate accounts, block abuse or remove users.</p>
    </div>
  </div>

  <!-- Toolbar -->
  <div class="toolbar my-4">
    <span class="chip active" data-status="all">All</span>
    <span class="chip" data-status="ACTIVE">Active</span>
    <span class="chip" data-status="BLOCK">Blocked</span>
    <span class="chip" data-status="DELETE">Deleted</span>

    <div class="ms-auto d-flex align-items-center gap-2 flex-wrap">
      <select id="leaseFilter" class="form-select" style="width: 140px;">
        <option value="all">All members</option>
        <option value="withLease">With active leases</option>
        <option value="noLease">No active lease</option>
      </select>
      <div class="ab-search">
        <i class="bi bi-search"></i>
        <input id="searchInput" class="form-control" placeholder="Search users…" />
      </div>
    </div>
  </div>

  <!-- Table -->
  <div class="ab-card ab-table-wrap">
    <div class="table-responsive">
      <table class="table ab-table align-middle">
        <thead>
          <tr>
            <th>User</th>
            <th>Address</th>
            <th>Active Leases</th>
            <th>Member Since</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody id="userTableBody"></tbody>
      </table>
    </div>
  </div>

  <!-- Pagination -->
  <div class="ab-pager d-flex justify-content-between align-items-center flex-wrap gap-2">
    <p class="ab-result-count text-muted-2 mb-0" id="resultCount"></p>
    <div class="d-flex align-items-center gap-2">
      <button class="btn btn-outline-ink btn-sm" id="prevPage" disabled>
        <i class="bi bi-chevron-left"></i> Prev
      </button>
      <span class="text-muted-2" id="pageLabel" style="font-size:13px;"></span>
      <button class="btn btn-outline-ink btn-sm" id="nextPage" disabled>
        Next <i class="bi bi-chevron-right"></i>
      </button>
    </div>
  </div>
</main>

<%- include('includes/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/config.js"></script>
<script src="/js/users.js"></script>
