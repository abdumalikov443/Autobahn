<%- include('includes/header') %>

<main class="container">
  <!-- Page head -->
  <div class="page-head d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
      <p class="eyebrow mb-1">Fleet Management</p>
      <h1 class="section-title">Vehicles</h1>
      <p class="text-muted-2 mb-0">Manage every car in the Autobahn showroom — pause, activate or remove listings.</p>
    </div>
    <button class="btn btn-gold" data-bs-toggle="modal" data-bs-target="#addVehicleModal">
      <i class="bi bi-plus-lg me-1"></i>Add new vehicle
    </button>
  </div>

  <!-- Toolbar -->
  <div class="toolbar my-4">
    <span class="chip active" data-category="all">All</span>
    <span class="chip" data-category="SEDAN">Sedan</span>
    <span class="chip" data-category="COUPE">Coupe</span>
    <span class="chip" data-category="SUV">SUV</span>
    <span class="chip" data-category="HATCHBACK">Hatchback</span>
    <span class="chip" data-category="ELECTRIC">Electric</span>
    <span class="chip" data-category="OFF_ROAD">Off-road</span>

    <div class="ms-auto d-flex align-items-center gap-2 flex-wrap">
      <select id="statusFilter" class="form-select" style="width: 140px;">
        <option value="all">All statuses</option>
        <option value="ACTIVE">Active</option>
        <option value="PAUSE">Paused</option>
        <option value="OUT_OF_STOCK">Out of stock</option>
        <option value="DELETED">Deleted</option>
      </select>
      <div class="ab-search">
        <i class="bi bi-search"></i>
        <input id="searchInput" class="form-control" placeholder="Search models…" />
      </div>
    </div>
  </div>

  <!-- Table -->
  <div class="ab-card ab-table-wrap">
    <div class="table-responsive">
      <table class="table ab-table align-middle">
        <thead>
          <tr>
            <th>Vehicle</th>
            <th>Category</th>
            <th>Monthly Price</th>
            <th>Stock</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody id="vehicleTableBody"></tbody>
      </table>
    </div>
  </div>

  <!-- Pagination -->
  <div class="ab-pager d-flex justify-content-between align-items-center flex-wrap gap-2">
    <p class="ab-result-count text-muted-2 mb-0" id="resultCount"></p>
    <div class="d-flex align-items-center gap-2">
      <button class="btn btn-outline-ink btn-sm" id="prevPage" disabled>
        <i class="bi bi-chevron-left"></i> Prev
      </button>
      <span class="text-muted-2" id="pageLabel" style="font-size:13px;"></span>
      <button class="btn btn-outline-ink btn-sm" id="nextPage" disabled>
        Next <i class="bi bi-chevron-right"></i>
      </button>
    </div>
  </div>
</main>

<!-- ===== Add New Vehicle Modal ===== -->
<div class="modal fade" id="addVehicleModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add New Vehicle</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="addVehicleForm" novalidate>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" for="vehicleBrand">Brand</label>
              <input class="form-control" id="vehicleBrand" name="vehicleBrand" list="brandOptions" placeholder="e.g. BMW" required />
              <datalist id="brandOptions">
                <option value="BMW"></option>
                <option value="Mercedes-Benz"></option>
                <option value="Audi"></option>
                <option value="Porsche"></option>
                <option value="Volkswagen"></option>
              </datalist>
            </div>
            <div class="col-md-6">
              <label class="form-label" for="vehicleModel">Model name</label>
              <input class="form-control" id="vehicleModel" name="vehicleModel" placeholder="e.g. M4 Competition" required />
            </div>

            <div class="col-md-4">
              <label class="form-label" for="vehicleType">Category</label>
              <select class="form-select" id="vehicleType" name="vehicleType" required>
                <option value="SEDAN">Sedan</option>
                <option value="COUPE">Coupe</option>
                <option value="SUV">SUV</option>
                <option value="HATCHBACK">Hatchback</option>
                <option value="ELECTRIC">Electric</option>
                <option value="OFF_ROAD">Off-road</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="vehicleYear">Year</label>
              <input type="number" class="form-control" id="vehicleYear" name="vehicleYear" placeholder="2026" min="1950" max="2100" required />
            </div>
            <div class="col-md-4">
              <label class="form-label" for="vehiclePrice">Monthly price (₩)</label>
              <input type="number" class="form-control" id="vehiclePrice" name="vehiclePrice" placeholder="2190000" min="0" required />
            </div>

            <div class="col-md-6">
              <label class="form-label" for="vehicleQuantity">Quantity in stock</label>
              <input type="number" class="form-control" id="vehicleQuantity" name="vehicleQuantity" placeholder="3" min="1" required />
              <small class="text-muted-2" style="font-size:12px;">At least 1 — a new car cannot start sold out.</small>
            </div>
            <div class="col-md-6 d-flex align-items-center">
              <p class="text-muted-2 mb-0" style="font-size:13px;">
                <i class="bi bi-pause-circle me-1"></i>
                New listings are saved as <strong>Paused</strong> — activate them from the table
                once you have checked the details.
              </p>
            </div>

            <div class="col-12"><hr class="my-1" /><p class="eyebrow mb-0">Specification</p></div>

            <div class="col-md-4">
              <label class="form-label" for="specPower">Power (hp)</label>
              <input type="number" class="form-control" id="specPower" name="power" placeholder="510" min="0" required />
            </div>
            <div class="col-md-4">
              <label class="form-label" for="specAcceleration">0–100 km/h (s)</label>
              <input type="number" step="0.1" class="form-control" id="specAcceleration" name="acceleration" placeholder="3.9" min="0" required />
            </div>
            <div class="col-md-4">
              <label class="form-label" for="specTopSpeed">Top speed (km/h)</label>
              <input type="number" class="form-control" id="specTopSpeed" name="topSpeed" placeholder="250" min="0" required />
            </div>

            <div class="col-md-4">
              <label class="form-label" for="specFuel">Fuel</label>
              <select class="form-select" id="specFuel" name="fuel" required>
                <option value="PETROL">Petrol</option>
                <option value="DIESEL">Diesel</option>
                <option value="ELECTRICITY">Electricity</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="specDriveTrain">Drivetrain</label>
              <select class="form-select" id="specDriveTrain" name="driveTrain" required>
                <option value="AWD">AWD</option>
                <option value="RWD">RWD</option>
                <option value="FWD">FWD</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label" for="specSeats">Seats</label>
              <input type="number" class="form-control" id="specSeats" name="seats" placeholder="4" min="1" max="9" required />
            </div>

            <div class="col-12"><hr class="my-1" /></div>

            <div class="col-12">
              <label class="form-label" for="vehicleDesc">Description</label>
              <textarea class="form-control" id="vehicleDesc" name="vehicleDesc" rows="3" placeholder="Short description shown on the fleet page…"></textarea>
            </div>
            <div class="col-12">
              <label class="form-label" for="vehicleImages">Vehicle images (1–5)</label>
              <input type="file" class="form-control" id="vehicleImages" name="vehicleImages" accept="image/png, image/jpeg, image/jpg" multiple required />
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-ink" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-gold" id="saveVehicleBtn">
            <i class="bi bi-check-lg me-1"></i>Save vehicle
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('includes/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/config.js"></script>
<script src="/js/vehicles.js"></script>
